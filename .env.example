# Required for Step 5 (LLM scoring) and the /api/chat web app endpoint.
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended for Step 3 (PubMed). Without it NCBI rate-limits at
# ~3 req/sec; with a personal key the limit is ~10 req/sec.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Override the local web app port (default 8000).
# BACKEND_PORT=8000
